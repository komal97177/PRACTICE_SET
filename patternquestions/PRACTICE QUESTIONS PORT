<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Portfolio</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background: #f4f4f4;
        }

        header {
            background: #333;
            color: #fff;
            padding: 15px 0;
            text-align: center;
        }

        nav {
            background: #555;
            padding: 10px;
            text-align: center;
        }

        nav a {
            color: white;
            margin: 0 15px;
            text-decoration: none;
            font-weight: bold;
        }

        nav a:hover {
            color: #ff9800;
        }

        .container {
            padding: 20px;
        }

        .section {
            margin-bottom: 40px;
        }

        .card {
            background: white;
            padding: 15px;
            margin: 10px 0;
            border-radius: 8px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }

        footer {
            background: #333;
            color: white;
            text-align: center;
            padding: 10px;
        }
    </style>
</head>
<body>

<header>
    <h1>My Portfolio</h1>
    <p>Welcome to my personal website</p>
</header>

<nav>
    <a href="#about">About</a>
    <a href="#practice">Practice Sets</a>
    <a href="#projects">Projects</a>
    <a href="#contact">Contact</a>
</nav>

<div class="container">

    <!-- About Section -->
    <div id="about" class="section">
        <h2>About Me</h2>
        <div class="card">
            <p>Hello! I am a beginner web developer learning HTML, CSS, and JavaScript.</p>
        </div>
    </div>

    <!-- Practice Sets -->
    <div id="practice" class="section">
        <h2>Practice Sets</h2>

        <div class="card">
            <h3>Practice Set 1</h3>
            <p>Basic HTML structure and tags.</p>
        </div>

        <div class="card">
            <h3>Practice Set 2</h3>
            <p>Forms and input fields.</p>
        </div>

        <div class="card">
            <h3>Practice Set 3</h3>
            <p>CSS styling and layouts.</p>
        </div>
    </div>

    <!-- Projects -->
    <div id="projects" class="section">
        <h2>Projects</h2>

        <div class="card">
            <h3>Portfolio Website</h3>
            <p>A personal website to showcase my skills.</p>
        </div>

        <div class="card">
            <h3>Calculator App</h3>
            <p>A simple calculator using JavaScript.</p>
        </div>
    </div>

    <!-- Contact -->
    <div id="contact" class="section">
        <h2>Contact Me</h2>
        <div class="card">
            <p>Email: yourname@email.com</p>
            <p>GitHub: github.com/yourname</p>
        </div>
    </div>

</div>

<footer>
    <p>© 2026 My Portfolio</p>
</footer>

</body>
</html>
